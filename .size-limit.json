[
  {
    "name": "core: App + command",
    "path": "packages/composurejs/dist/index.js",
    "import": "{ App, command }",
    "limit": "19.5 kB"
  },
  {
    "name": "core + Views: App, command, tags, JSX runtime",
    "path": ["packages/composurejs/dist/index.js", "packages/composurejs/dist/jsx-runtime.js"],
    "import": {
      "packages/composurejs/dist/index.js": "{ App, command, Container, Text, Row, Button }",
      "packages/composurejs/dist/jsx-runtime.js": "{ jsx }"
    },
    "limit": "19.5 kB"
  },
  {
    "name": "composurejs/rest: createMessage",
    "path": "packages/composurejs/dist/rest/index.js",
    "import": "{ createMessage }",
    "limit": "6.5 kB"
  },
  {
    "name": "example bot Worker (vite build)",
    "path": "examples/bot/dist/composurejs_example_bot/index.js",
    "limit": "22.5 kB"
  }
]
