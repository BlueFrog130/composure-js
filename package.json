{
  "name": "composurejs-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.0",
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter ./packages/* build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm build && vitest run",
    "test:watch": "vitest",
    "size": "pnpm -C examples/bot build && size-limit",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@size-limit/esbuild": "^14.2.0",
    "@size-limit/file": "^14.2.0",
    "@types/node": "^26.6.5",
    "size-limit": "^14.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
