# Copy to .env.local (the Dev Application's secrets, read by `pnpm dev` and `pnpm sync --mode development`)
# and to .env.production.local (production's, for `pnpm sync`; `vite dev` never reads it). Both are
# gitignored. The Dev Loop's settings live in vite.config.ts (`dev`).
# Verifies Interactions: Developer Portal → General Information → Public Key.
DISCORD_PUBLIC_KEY=
# For c.bot, `pnpm sync` and the Dev Loop: Developer Portal → Bot → Token.
DISCORD_TOKEN=
# Optional: read from the token when unset.
DISCORD_APPLICATION_ID=
# Guilds for Commands with scope: "dev" (comma-separated).
COMPOSURE_SCOPE_DEV=
# Optional: a named Cloudflare Tunnel's token, when vite.config.ts sets `dev.tunnel: { name, hostname }`.
CLOUDFLARE_TUNNEL_TOKEN=
