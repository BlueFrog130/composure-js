# Copy to .env (or .dev.vars for `vite dev` on Workers) and fill in.
# Verifies Interactions: Developer Portal → General Information → Public Key.
DISCORD_PUBLIC_KEY=
# For c.bot and `pnpm sync`: Developer Portal → Bot → Token.
DISCORD_TOKEN=
# Optional: read from the token when unset.
DISCORD_APPLICATION_ID=
# Guilds for Commands with scope: "dev" (comma-separated).
COMPOSURE_SCOPE_DEV=
# Dev Loop (`pnpm dev` / `pnpm dev:node`): use a separate dev application.
# Naming it here lets `vite dev` point its Interactions Endpoint URL at the tunnel.
COMPOSURE_DEV_APPLICATION_ID=
# The guild `vite dev` syncs Commands to on start and on every change.
COMPOSURE_DEV_GUILD=
# Optional: your own tunnel's public URL (forwarding to `vite dev`), used instead of a quick tunnel.
COMPOSURE_DEV_TUNNEL_URL=
