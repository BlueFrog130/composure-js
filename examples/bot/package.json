{
  "name": "@composurejs/example-bot",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:node": "node --conditions=@composurejs/source --env-file-if-exists=.env --import tsx src/node.ts",
    "dev:worker": "wrangler dev",
    "check:worker": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "composurejs": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "wrangler": "^4.151.3"
  }
}
