{
  "name": "@composurejs/example-bot",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:node": "vite -c vite.node.config.ts",
    "build": "vite build",
    "build:node": "vite build -c vite.node.config.ts",
    "build:bun": "vite build -c vite.bun.config.ts",
    "start:node": "node --env-file-if-exists=.env dist/node/index.js",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "tsc -p tsconfig.json",
    "sync": "composure sync",
    "sync:check": "composure sync --check",
    "coldstart": "node scripts/coldstart.mjs"
  },
  "dependencies": {
    "@composurejs/adapter-bun": "workspace:*",
    "@composurejs/adapter-node": "workspace:*",
    "composurejs": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@composurejs/cli": "workspace:*",
    "@composurejs/vite": "workspace:*",
    "miniflare": "5.20261019.1-beta",
    "vite": "^8.3.5",
    "wrangler": "^4.151.3"
  }
}
