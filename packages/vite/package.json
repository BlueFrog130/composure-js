    "magic-string": "^1.4.3",
    "oxc-parser": "^0.155.0",
    "untun": "^0.2.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "composurejs": "workspace:*",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
