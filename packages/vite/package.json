{
  "name": "@composurejs/vite",
  "version": "0.0.0",
  "description": "Vite plugin for composurejs: Inline Handler hoisting (and later the dev loop)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BlueFrog130/composure-js.git",
    "directory": "packages/vite"
  },
  "homepage": "https://bluefrog130.github.io/composure-js/",
  "bugs": "https://github.com/BlueFrog130/composure-js/issues",
  "keywords": [
    "discord",
    "discord-bot",
    "interactions",
    "cloudflare-workers",
    "vite",
    "jsx"
  ],
  "type": "module",
  "files": [
    "dist",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "@composurejs/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "node -e \"require('fs').copyFileSync('../../LICENSE','LICENSE')\""
