{
  "name": "@composurejs/cli",
  "version": "0.1.2",
  "description": "composure sync: make Discord's Command Definitions match a composurejs App",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BlueFrog130/composure-js.git",
    "directory": "packages/cli"
  },
  "homepage": "https://bluefrog130.github.io/composure-js/",
  "bugs": "https://github.com/BlueFrog130/composure-js/issues",
  "keywords": [
    "discord",
    "discord-bot",
    "interactions",
    "cloudflare-workers",
    "vite",
    "jsx"
  ],
  "type": "module",
  "files": [
    "dist",
    "LICENSE"
  ],
  "bin": {
    "composure": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "@composurejs/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "node -e \"require('fs').copyFileSync('../../LICENSE','LICENSE')\""
  },
  "peerDependencies": {
    "composurejs": "workspace:^",
    "vite": "^8.0.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@composurejs/vite": "workspace:*",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "composurejs": "workspace:^",
    "discord-api-types": "^0.38.57",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
