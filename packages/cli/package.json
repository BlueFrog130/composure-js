{
  "name": "@composurejs/cli",
  "version": "0.0.0",
  "description": "composure sync: make Discord's Command Definitions match a composurejs App",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "bin": {
    "composure": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "@composurejs/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "composurejs": "workspace:^",
    "vite": "^8.0.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@composurejs/vite": "workspace:*",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "composurejs": "workspace:^",
    "discord-api-types": "^0.38.57",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
