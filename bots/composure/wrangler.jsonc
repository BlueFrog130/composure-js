// Two environments, each with its own Discord application and home-server channels. The top level
// is dev: it only runs locally with `vite dev`. `production` is deployed as the Worker
// `composurejs-bot`: `vite build` selects it (.env.production sets CLOUDFLARE_ENV), then
// `wrangler deploy`. `vars` and `kv_namespaces` are not inherited, so production lists its own.
//
// Secrets: `npx wrangler secret put <NAME> --env production`, and `.dev.vars` for dev:
// - DISCORD_PUBLIC_KEY (required), DISCORD_TOKEN (every REST call)
// - GITHUB_TOKEN: fine-grained, read-only "Contents" on the repository; without it GitHub
//   allows 60 requests an hour per IP, shared with every Worker on that IP
//
// The home server also runs composure-rs's bot (the Worker `composure-bot`). Every name here
// differs from its: Worker, KV namespace, Discord application, announcement channel (README.md).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "composurejs-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Workers Logs: the structured objects the bot logs
  "observability": { "enabled": true },
  // scheduled() checks GitHub for new releases every 15 minutes (inherited by production)
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": {
    "DISCORD_APPLICATION_ID": "",
    "ANNOUNCE_CHANNEL_ID": "",
    "FEEDBACK_CHANNEL_ID": "",
    "LOG_CHANNEL_ID": "",
    "GITHUB_REPO": "BlueFrog130/composure-js",
  },
  // Releases, the last version announced, and npm stats (10-minute TTL). Dev's is simulated
  // locally (in .wrangler/), so it has no id and never touches production's.
  "kv_namespaces": [{ "binding": "KV" }],
  "env": {
    "production": {
      // Without it wrangler appends the env: `composurejs-bot-production`
      "name": "composurejs-bot",
      "vars": {
        "DISCORD_APPLICATION_ID": "",
        "ANNOUNCE_CHANNEL_ID": "",
        "FEEDBACK_CHANNEL_ID": "",
        "LOG_CHANNEL_ID": "",
        "GITHUB_REPO": "BlueFrog130/composure-js",
      },
      // `npx wrangler kv namespace create composurejs-bot`, then add its "id" here (composure-rs's
      // bot has its own namespace; they never share one)
      "kv_namespaces": [{ "binding": "KV" }],
    },
  },
}
