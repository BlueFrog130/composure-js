# Secrets only (settings are in vite.config.ts and wrangler.jsonc). Both files are gitignored, and
# variables already set in the environment win.
# - .env.local: the Dev Application's, for `pnpm dev` (Vite and the Worker on workerd).
# - .env.production.local: production's, for `pnpm sync` (production mode). `vite dev` never reads it.
DISCORD_PUBLIC_KEY=
DISCORD_TOKEN=
# Fine-grained, read-only "Contents" on the repository (optional: GitHub allows 60 requests an hour without it).
GITHUB_TOKEN=
# Optional: a named Cloudflare Tunnel's token, when vite.config.ts sets `dev.tunnel: { name, hostname }`.
CLOUDFLARE_TUNNEL_TOKEN=
