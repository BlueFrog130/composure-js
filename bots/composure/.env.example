# Copy to .dev.vars for `vite dev`, and to .env for `pnpm sync` (production's token there).
# Both are gitignored. Variables already set in the environment win.
DISCORD_PUBLIC_KEY=
DISCORD_TOKEN=
GITHUB_TOKEN=
# Dev Loop: the dev application (lets `vite dev` point its Interactions Endpoint URL at the tunnel)
COMPOSURE_DEV_APPLICATION_ID=
# The guild `vite dev` syncs Commands to on start and on every change
COMPOSURE_DEV_GUILD=
# Optional: your own tunnel's public URL (forwarding to `vite dev`), used instead of a quick tunnel.
COMPOSURE_DEV_TUNNEL_URL=
